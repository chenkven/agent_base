# 供命令行和网页管理员聊天使用。普通网页用户在会话页填写自己的 Key。
# 到 DeepSeek 平台申请密钥，再填入本地 .env；不要提交 .env。
DEEPSEEK_API_KEY=

# 使用官方接口时留空；只有走兼容代理时才填写。
# DEEPSEEK_BASE_URL=

# 官方 SDK 示例使用的模型与 profile。
AGENT_MODEL=deepseek-v4-flash
AGENT_PROFILE=sdk

# 留空使用模型默认输出上限；填正整数可限制每次输出。
AGENT_MAX_TOKENS=

# 首次启动时用此口令创建 MySQL 中的 admin 管理员账号。不要提交真实值。
SERVICE_ACCESS_TOKEN=

# MySQL 8：DBeaver 和网页服务共同连接的数据库。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agent_base
MYSQL_TEST_DATABASE=agent_base_test
MYSQL_USER=agent_base_app
MYSQL_PASSWORD=

# 网页请求中，Harness 启动与一轮模型调用共用的超时秒数（默认 180）。
WEB_CHAT_TIMEOUT_SECONDS=180
